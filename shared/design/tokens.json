{
  "base": {
    "color": {
      "white": "#ffffff",
      "black": "#000000",
      "gray": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#020617"
      },
      "blue": {
        "300": "#93c5fd",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "600": "#2563eb",
        "700": "#1d4ed8"
      },
      "red": {
        "300": "#fca5a5",
        "400": "#f87171",
        "500": "#ef4444",
        "600": "#dc2626",
        "700": "#b91c1c"
      },
      "orange": {
        "300": "#fdba74",
        "400": "#fb923c",
        "600": "#ea580c",
        "700": "#c2410c"
      },
      "amber": {
        "300": "#fcd34d",
        "400": "#fbbf24",
        "600": "#d97706",
        "700": "#b45309"
      },
      "green": {
        "300": "#86efac",
        "400": "#4ade80",
        "600": "#16a34a",
        "700": "#15803d"
      }
    },
    "space": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12,
      "full": 9999
    },
    "fontSize": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 18,
      "xl": 22,
      "2xl": 28
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "duration": {
      "fast": 120,
      "normal": 200,
      "slow": 320
    }
  },
  "semantic": {
    "color": {
      "bg": {
        "app": { "light": "{color.gray.50}", "dark": "{color.gray.950}" },
        "surface": { "light": "{color.white}", "dark": "{color.gray.900}" },
        "subtle": { "light": "{color.gray.100}", "dark": "{color.gray.800}" },
        "inverse": { "light": "{color.gray.900}", "dark": "{color.gray.50}" }
      },
      "text": {
        "primary": { "light": "{color.gray.900}", "dark": "{color.gray.50}" },
        "muted": { "light": "{color.gray.500}", "dark": "{color.gray.400}" },
        "inverse": { "light": "{color.white}", "dark": "{color.gray.900}" },
        "onAccent": { "light": "{color.white}", "dark": "{color.gray.950}" }
      },
      "border": {
        "default": { "light": "{color.gray.200}", "dark": "{color.gray.700}" },
        "strong": { "light": "{color.gray.400}", "dark": "{color.gray.500}" }
      },
      "accent": {
        "default": { "light": "{color.blue.600}", "dark": "{color.blue.400}" },
        "pressed": { "light": "{color.blue.700}", "dark": "{color.blue.300}" }
      },
      "state": {
        "urgent": { "light": "{color.red.600}", "dark": "{color.red.400}" },
        "overdue": { "light": "{color.orange.600}", "dark": "{color.orange.400}" },
        "dueSoon": { "light": "{color.amber.600}", "dark": "{color.amber.400}" },
        "done": { "light": "{color.green.600}", "dark": "{color.green.400}" },
        "offline": { "light": "{color.gray.600}", "dark": "{color.gray.300}" }
      }
    },
    "space": {
      "screen": { "padding": "{space.4}" },
      "card": { "padding": "{space.4}", "gap": "{space.2}" },
      "list": { "gap": "{space.2}" },
      "inline": { "gap": "{space.2}" },
      "control": { "paddingX": "{space.4}", "paddingY": "{space.3}" }
    },
    "radius": {
      "card": "{radius.lg}",
      "control": "{radius.md}",
      "badge": "{radius.full}"
    },
    "fontSize": {
      "caption": "{fontSize.xs}",
      "label": "{fontSize.sm}",
      "body": "{fontSize.md}",
      "title": "{fontSize.lg}",
      "heading": "{fontSize.xl}",
      "display": "{fontSize.2xl}"
    },
    "fontWeight": {
      "body": "{fontWeight.regular}",
      "label": "{fontWeight.medium}",
      "title": "{fontWeight.bold}"
    },
    "duration": {
      "press": "{duration.fast}",
      "transition": "{duration.normal}"
    }
  }
}
